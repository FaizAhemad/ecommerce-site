generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String               @id @default(cuid())
  email             String?              @unique
  passwordHash      String?
  name              String?
  phone             String?              @unique
  phoneVerifiedAt   DateTime?
  emailVerifiedAt   DateTime?
  role              UserRole             @default(CUSTOMER)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  accounts          Account[]
  sessions          Session[]
  addresses         Address[]
  carts             Cart[]
  wishlist          Wishlist?
  orders            Order[]
  reviews           Review[]
  verificationTokens VerificationToken[]
  messagesSent      CustomerMessage[] @relation("SentMessages")
  messagesReceived  CustomerMessage[] @relation("ReceivedMessages")
  returnRequests    ReturnRequest[]
  supportTickets    SupportTicket[]
  supportReplies SupportReply[]
  purchaseFeedback  PurchaseFeedback?
  shopMemberships ShopMembership[]
}

model PurchaseFeedback {
  userId    String   @id
  orderId   String   @unique
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  replies SupportReply[]
  attachments SupportAttachment[]
  id          String   @id
  userId      String
  subject     String
  body        String
  status      String   @default("OPEN")
  resolution  String?
  emailStatus String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model SupportAttachment {
  id String @id
  ticketId String
  contentType String
  data String
  createdAt DateTime @default(now()) @db.Timestamp(3)
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([ticketId])
}

model SupportReply {
  id String @id
  ticketId String
  authorId String
  fromAdmin Boolean
  body String
  createdAt DateTime @default(now()) @db.Timestamp(3)
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([ticketId, createdAt])
}

enum UserRole {
  CUSTOMER
  ADMIN
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  expiresAt DateTime @db.Timestamptz(3)
  @@index([expiresAt])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  purpose   TokenPurpose @default(EMAIL_VERIFICATION)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId])
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  MOBILE_VERIFICATION
  PASSWORD_RESET
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String?
  name         String
  line1        String
  line2        String?
  city         String
  state        String
  postalCode   String
  country      String   @default("IN")
  phone        String?
  isDefault    Boolean  @default(false)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([userId])
}

model Category {
  name      String    @id
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  shopOwnership ShopProduct?
  id          String         @id
  name        String
  slug        String         @unique
  description String?
  category    String
  categoryRecord Category @relation(fields: [category], references: [name], onDelete: Restrict, onUpdate: Cascade)
  priceMinor  Int
  shippingFeeMinor Int?
  compareAtPriceMinor Int?
  currency    String         @default("INR")
  rating      Float          @default(0)
  reviewCount Int            @default(0)
  stock       Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      ProductImage[]
  videos      ProductVideo[]
  colors      ProductColor[]
  reviews     Review[]
  cartItems   CartItem[]
  wishlistItems WishlistItem[]
  orderItems  OrderItem[]
  @@index([category, isActive])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
}

model ProductVideo {
  id        String  @id @default(cuid())
  productId String
  url       String
  poster    String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
}

model ProductColor {
  id        String  @id @default(cuid())
  productId String
  name      String
  hex       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, name])
}

model Review {
  id        String        @id @default(cuid())
  productId String
  userId    String
  rating    Int
  body      String?
  status    ReviewStatus  @default(PENDING)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     ReviewMedia[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@unique([productId, userId])
  @@index([productId, status])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model ReviewMedia {
  id       String @id @default(cuid())
  reviewId String
  url      String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  @@unique([cartId, productId])
  @@index([productId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())
  @@unique([wishlistId, productId])
  @@index([productId])
}

model Order {
  sellerOrders SellerOrder[]
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String
  shippingAddressId String?
  status          OrderStatus   @default(PENDING)
  subtotalMinor   Int
  shippingMinor   Int            @default(0)
  taxMinor        Int            @default(0)
  totalMinor      Int
  currency        String         @default("INR")
  user            User          @relation(fields: [userId], references: [id])
  shippingAddress Address?      @relation(fields: [shippingAddressId], references: [id])
  items           OrderItem[]
  payment         Payment?
  shipment        Shipment?
  returns         ReturnRequest[]
  purchaseFeedback PurchaseFeedback?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([userId, createdAt])
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String
  userId      String
  reason      String
  status      ReturnStatus @default(REQUESTED)
  resolution  String?
  order       Order        @relation(fields: [orderId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([orderId])
  @@index([userId])
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

model CustomerMessage {
  id         String    @id @default(cuid())
  senderId   String
  recipientId String?
  recipientEmail String
  subject    String
  body       String
  status     String    @default("QUEUED")
  sentAt     DateTime?
  sender     User      @relation("SentMessages", fields: [senderId], references: [id])
  recipient  User?     @relation("ReceivedMessages", fields: [recipientId], references: [id])
  createdAt  DateTime  @default(now())
  @@index([recipientEmail])
}

model StoreSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model OrderItem {
  sellerSnapshot ShopOrderItem?
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  unitPriceMinor Int
  shippingFeeMinor Int      @default(0)
  quantity       Int
  discountMinor Int @default(0)
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])
  @@index([productId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  provider          PaymentProvider
  providerOrderId   String?
  providerPaymentId String?
  amountMinor       Int
  status            PaymentStatus @default(PENDING)
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([providerOrderId])
}

enum PaymentProvider {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model Shipment {
  id          String           @id @default(cuid())
  orderId     String           @unique
  carrier     String?
  trackingCode String?
  status      ShipmentStatus   @default(PENDING)
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events      TrackingEvent[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
}

model TrackingEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  status      String
  description String?
  location    String?
  occurredAt  DateTime
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  @@index([shipmentId, occurredAt])
}

model NewsletterSubscription {
  id           String    @id @default(cuid())
  email        String    @unique
  status       String    @default("ACTIVE")
  resendContactId String?
  subscribedAt DateTime  @default(now())
  unsubscribedAt DateTime?
  updatedAt    DateTime  @updatedAt
}

model Shop {
  sellerOrders SellerOrder[]
  id String @id
  slug String @unique
  name String
  phone String?
  address String?
  city String?
  gstReviewStatus String @default("PENDING")
  status String @default("PENDING")
  isPlatform Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @default(now()) @db.Timestamp(3)
  memberships ShopMembership[]
  products ShopProduct[]
  orderItems ShopOrderItem[]
}

model ShopMembership {
  shopId String
  userId String
  status String @default("PENDING")
  createdAt DateTime @default(now()) @db.Timestamp(3)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([shopId, userId])
  @@index([userId, status])
}

model ShopProduct {
  productId String @id
  shopId String
  moderationStatus String @default("DRAFT")
  offerStatus String @default("NOT_OFFERED")
  feeType String?
  feeValue Int?
  offerVersion Int @default(0)
  acceptedOfferVersion Int?
  createdAt DateTime @default(now()) @db.Timestamp(3)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  @@index([shopId, moderationStatus])
}

model ShopOrderItem {
  sellerOrderId String
  sellerOrder SellerOrder @relation(fields: [sellerOrderId, shopId], references: [id, shopId], onDelete: Cascade)
  orderItemId String @id
  shopId String
  shopName String
  feeType String?
  feeValue Int?
  offerVersion Int?
  feeBaseMinor Int @default(0)
  feeAmountMinor Int @default(0)
  feeStatus String @default("PENDING")
  createdAt DateTime @default(now()) @db.Timestamp(3)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  @@index([shopId])
}

model SellerOrder {
  id String @id
  orderId String
  shopId String
  shopName String
  status String @default("PENDING")
  carrier String?
  trackingCode String?
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @default(now()) @db.Timestamp(3)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  items ShopOrderItem[]
  events SellerOrderEvent[]
  returns SellerReturn[]
  @@unique([orderId, shopId])
  @@unique([id, shopId])
  @@index([shopId, createdAt])
}

model SellerOrderEvent {
  id String @id
  sellerOrderId String
  status String
  reason String
  actorId String
  createdAt DateTime @default(now()) @db.Timestamp(3)
  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  @@index([sellerOrderId, createdAt])
}

model SellerReturn {
  id String @id
  sellerOrderId String @unique
  reason String
  status String @default("REQUESTED")
  resolution String @default("")
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @default(now()) @db.Timestamp(3)
  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
}
