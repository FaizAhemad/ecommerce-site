{
  "name": "ecommerce-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <24"
  },
  "scripts": {
    "dev": "node scripts/check-node.mjs && vite",
    "build": "prisma generate && tsc -b && tsc -p tsconfig.api.json --pretty false && vite build",
    "test": "node --experimental-strip-types --test tests/http-timeout.test.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "@tanstack/react-query": "^5.102.8",
    "@vercel/blob": "^2.8.0",
    "i18next": "^26.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "prisma": "^6.12.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
